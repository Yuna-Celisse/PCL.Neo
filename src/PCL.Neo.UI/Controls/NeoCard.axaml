<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="using:PCL.Neo.UI.Controls">

    <Design.PreviewWith>
        <Border Padding="20" Background="#f0f0f0">
            <ctrl:NeoCard Title="测试卡片标题" Width="400">
                <StackPanel Spacing="8">
                    <TextBlock Text="这是卡片内容第一行" />
                    <TextBlock Text="这是卡片内容第二行" />
                </StackPanel>
            </ctrl:NeoCard>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type ctrl:NeoCard}" TargetType="ctrl:NeoCard">
        <Setter Property="Background" Value="{DynamicResource NeoColorGray8Brush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="18,14,18,16" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Duration="0:0:0.18" Property="RenderTransform" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_OuterBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="0 1 4 0 #12000000"
                        RenderTransform="{TemplateBinding RenderTransform}">
                    <Grid RowDefinitions="Auto,*">
                        <!-- PCL 经典卡片标题：加粗 14.5px，带微透明度与下间距 -->
                        <TextBlock Grid.Row="0"
                                   Text="{TemplateBinding Title}"
                                   IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontWeight="Bold"
                                   FontSize="14.5"
                                   Foreground="{DynamicResource NeoColorGray1Brush}"
                                   Margin="18,14,18,6" />

                        <!-- 内容宿主 -->
                        <ContentPresenter Grid.Row="1"
                                          Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- PCL 悬浮微抬升 -->
        <Style Selector="^:pointerover /template/ Border#PART_OuterBorder">
            <Setter Property="BoxShadow" Value="0 4 12 0 #22000000" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-1px)" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
