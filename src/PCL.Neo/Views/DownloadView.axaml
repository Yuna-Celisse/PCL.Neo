<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCL.Neo.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="PCL.Neo.Views.DownloadView"
             x:DataType="vm:DownloadViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- 头部操作栏 -->
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="版本下载" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="从 Mojang 官方元数据源拉取原版客户端清单" Opacity="0.7" FontSize="13" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Classes="accent" Content="拉取版本清单" Command="{Binding RefreshManifestCommand}" />
                <CheckBox Content="包含快照/开发版 (Snapshots)" IsChecked="{Binding IncludeSnapshots}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- 版本列表展示 -->
        <Border Grid.Row="1" Background="{DynamicResource NeoControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource NeoSystemAccentColorStrokeBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <ListBox ItemsSource="{Binding Versions}"
                     SelectedItem="{Binding SelectedVersion}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionItemViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="6,4">
                            <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Margin="8,0" Padding="6,2" Background="{DynamicResource NeoColorGray7Brush}" CornerRadius="4">
                                <TextBlock Text="{Binding Type}" FontSize="11" Opacity="0.8" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding ReleaseTime}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部安装操作与进度反馈 -->
        <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0">
            <ProgressBar Height="6" Minimum="0" Maximum="100"
                         Value="{Binding DownloadProgressValue}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Opacity="0.85" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="accent" Content="安装此版本"
                        Command="{Binding InstallSelectedVersionCommand}"
                        IsEnabled="{Binding !IsDownloading}" />
            </Grid>
        </StackPanel>
    </Grid>

</UserControl>
