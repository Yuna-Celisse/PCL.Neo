<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCL.Neo.ViewModels"
             xmlns:ctrl="using:PCL.Neo.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="480"
             x:Class="PCL.Neo.Views.DownloadView"
             x:DataType="vm:DownloadViewModel">

    <!-- 1:1 PCL 双栏下载器布局 -->
    <Grid ColumnDefinitions="300,*">
        <!-- 左侧筛选控制 (PanLeft) -->
        <Border Grid.Column="0" Background="{DynamicResource NeoColorGray7Brush}"
                Padding="20,18,18,18">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="14">
                    <TextBlock Text="下载源与过滤" FontWeight="SemiBold" FontSize="13" Opacity="0.75" />

                    <ctrl:NeoCard Padding="12,10">
                        <StackPanel Spacing="10">
                            <Button Classes="accent" Command="{Binding RefreshManifestCommand}"
                                    IsEnabled="{Binding !IsLoadingManifest}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                    <TextBlock Text="⟳" FontWeight="Bold" />
                                    <TextBlock Text="同步官方版本列表" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <CheckBox Content="包含开发版快照 (Snapshots)" IsChecked="{Binding IncludeSnapshots}" />
                        </StackPanel>
                    </ctrl:NeoCard>
                </StackPanel>

                <!-- 底部操作与进度条 -->
                <StackPanel Grid.Row="2" Spacing="10" Margin="0,0,0,6">
                    <ProgressBar Height="4" Minimum="0" Maximum="100"
                                 Value="{Binding DownloadProgressValue}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Opacity="0.75"
                               HorizontalAlignment="Center" TextWrapping="Wrap" />

                    <Button Classes="launch" Command="{Binding InstallSelectedVersionCommand}"
                            IsEnabled="{Binding !IsDownloading}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="⬇" FontWeight="Black" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="安装选定版本" FontWeight="Black" FontSize="16" Foreground="White"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧卡片式列表 (PanRight) -->
        <ScrollViewer Grid.Column="1" Margin="20,18">
            <StackPanel Spacing="12" MaxWidth="580" HorizontalAlignment="Left">
                <TextBlock Text="可供下载安装的 Minecraft 官方版本" FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />

                <ListBox ItemsSource="{Binding Versions}"
                         SelectedItem="{Binding SelectedVersion}"
                         Background="Transparent">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                        <Style Selector="ListBoxItem /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VersionItemViewModel">
                            <ctrl:NeoCard Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="32" Height="32"
                                            Background="{DynamicResource NeoSystemAccentColorLight3Brush}"
                                            CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="📦" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="13.5" />
                                        <TextBlock Text="{Binding Type}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ReleaseTime}" Opacity="0.5" FontSize="11.5" VerticalAlignment="Center" />
                                </Grid>
                            </ctrl:NeoCard>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
