<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCL.Neo.ViewModels"
             xmlns:ctrl="using:PCL.Neo.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="480"
             x:Class="PCL.Neo.Views.InstancesView"
             x:DataType="vm:InstancesViewModel">

    <!-- 1:1 复制 PCL PageSetupLeft (设置大类) + PageSetupUI 架构 -->
    <Grid ColumnDefinitions="260,*">
        <!-- 左侧 PageSetupLeft (设置目录 1:1 还原) -->
        <Border Grid.Column="0" Background="{DynamicResource NeoColorGray7Brush}"
                Padding="10,12,8,12">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="2">
                    <TextBlock Text="核心设置" Margin="12,4,6,4" Opacity="0.5" FontSize="11.5" FontWeight="SemiBold" />
                    <ctrl:NeoListItem Title="启动设置" IconText="🚀" IsChecked="True" />
                    <ctrl:NeoListItem Title="Java 运行时" IconText="☕" Subtitle="环境扫描与分配" />
                    <ctrl:NeoListItem Title="游戏版本管理" IconText="🎮" Subtitle="实例与文件结构" />
                    <ctrl:NeoListItem Title="联机与网络" IconText="🌐" />

                    <TextBlock Text="启动器设置" Margin="12,12,6,4" Opacity="0.5" FontSize="11.5" FontWeight="SemiBold" />
                    <ctrl:NeoListItem Title="界面与主题 (UI)" IconText="🎨" Subtitle="背景、透明度与配色" />
                    <ctrl:NeoListItem Title="语言与国际化" IconText="🌍" />
                    <ctrl:NeoListItem Title="通用设置" IconText="⚙" />

                    <TextBlock Text="其他" Margin="12,12,6,4" Opacity="0.5" FontSize="11.5" FontWeight="SemiBold" />
                    <ctrl:NeoListItem Title="关于 PCL.Neo" IconText="ℹ" />
                    <ctrl:NeoListItem Title="更新日志" IconText="🔄" />
                    <ctrl:NeoListItem Title="运行日志" IconText="📜" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧设置项卡片流 (PageSetupUI / PageSetupLaunch 还原) -->
        <ScrollViewer Grid.Column="1" Margin="20,16">
            <StackPanel Spacing="14" MaxWidth="580" HorizontalAlignment="Left">
                <!-- 1. 基础启动配置卡片 -->
                <ctrl:NeoCard Title="基础启动参数">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="离线游戏昵称" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PlayerName}" PlaceholderText="昵称" Height="30" FontSize="12.5" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="最大运行内存 (MB)" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxMemoryMb}" Height="30" FontSize="12.5" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="默认 Java 路径" VerticalAlignment="Center" FontSize="12.5" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding JavaPaths}"
                                          SelectedItem="{Binding SelectedJavaPath}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="⟳" Command="{Binding RefreshJavaListCommand}" Padding="8,4" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </ctrl:NeoCard>

                <!-- 2. 本地已扫描实例概览卡片 -->
                <ctrl:NeoCard Title="本地已就绪的游戏实例">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="扫描目录：~/.minecraft/versions" Opacity="0.6" FontSize="11.5" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="刷新目录" Command="{Binding RefreshInstancesCommand}" Padding="8,3" FontSize="11.5" />
                        </Grid>

                        <ListBox ItemsSource="{Binding Instances}"
                                 SelectedItem="{Binding SelectedInstance}"
                                 Background="Transparent">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                </Style>
                                <Style Selector="ListBoxItem /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocalInstanceItemViewModel">
                                    <Border Background="{DynamicResource NeoColorGray7Brush}"
                                            CornerRadius="6" Padding="12,8">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="🎮" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="13.5" />
                                                <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ctrl:NeoCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
