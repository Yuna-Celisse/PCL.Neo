<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCL.Neo.ViewModels"
             xmlns:ctrl="using:PCL.Neo.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="480"
             x:Class="PCL.Neo.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <ScrollViewer Margin="24,20">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <!-- 1. 原作者致敬与赞助卡片 (重度使用指南必须首位呈现) -->
            <ctrl:NeoCard Title="原作者致敬与赞助">
                <StackPanel Spacing="10">
                    <TextBlock Text="PCL 原版由 龙腾猫跃 (Meloong-Git) 倾力创作。若您喜爱 PCL，请务必支持原作者！"
                               TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="accent" Content="前往爱发电赞助 龙腾猫跃"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{x:Static vm:AboutViewModel.AuthorSponsorUrl}" />
                        <Button Content="PCL 官方主页"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{x:Static vm:AboutViewModel.UpstreamPclUrl}" />
                    </StackPanel>
                </StackPanel>
            </ctrl:NeoCard>

            <!-- 2. 二次开发声明 -->
            <ctrl:NeoCard Title="PCL.Neo 跨平台重构工程">
                <StackPanel Spacing="8">
                    <TextBlock Text="本项目基于社区许可与合理使用指南，致力于为 Linux、macOS 与多种非 x86 架构提供 100% 还原的 PCL 体验。"
                               TextWrapping="Wrap" FontSize="12.5" Opacity="0.8" LineHeight="19" />
                    <TextBlock Text="{Binding PlatformDescription, StringFormat='运行环境：{0}'}"
                               FontFamily="Consolas, monospace" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </ctrl:NeoCard>
        </StackPanel>
    </ScrollViewer>

</UserControl>
