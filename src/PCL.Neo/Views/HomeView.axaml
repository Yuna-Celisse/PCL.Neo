<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCL.Neo.ViewModels"
             xmlns:inst="using:PCL.Neo.Core.Minecraft.Instances"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="500"
             x:Class="PCL.Neo.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid ColumnDefinitions="310,*">
        <!-- 左侧控制面板 (Left Panel) -->
        <Border Grid.Column="0" Background="{DynamicResource NeoColorGray7Brush}"
                BorderBrush="{DynamicResource NeoColorGray6Brush}" BorderThickness="0,0,1,0"
                Padding="24,20">
            <Grid RowDefinitions="Auto,*,Auto" VerticalAlignment="Stretch">
                <!-- 顶部：玩家身份卡片 -->
                <StackPanel Grid.Row="0" Spacing="14">
                    <TextBlock Text="玩家离线身份" FontWeight="SemiBold" FontSize="13" Opacity="0.75" />
                    <Border Background="{DynamicResource NeoColorGray8Brush}" CornerRadius="8" Padding="12"
                            BorderBrush="{DynamicResource NeoColorGray5Brush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*">
                            <!-- 简易玩家头像占位 -->
                            <Border Grid.Column="0" Width="38" Height="38" Background="{DynamicResource NeoSystemAccentColorLight3Brush}"
                                    CornerRadius="6" Margin="0,0,12,0">
                                <TextBlock Text="S" FontWeight="Bold" Foreground="White" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1" Text="{Binding PlayerName}" Watermark="输入游戏昵称"
                                     VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 中间：Java 运行时选择 -->
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,20,0,0">
                    <TextBlock Text="Java 运行时" FontWeight="SemiBold" FontSize="13" Opacity="0.75" />
                    <ComboBox ItemsSource="{Binding JavaList}"
                              SelectedItem="{Binding SelectedJavaPath}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 底部：PCL 经典巨型启动按钮 -->
                <StackPanel Grid.Row="2" Spacing="10" Margin="0,0,0,8">
                    <TextBlock Text="{Binding LaunchStatusMessage}" FontSize="12" Opacity="0.75"
                               HorizontalAlignment="Center" TextWrapping="Wrap" />

                    <!-- 标志性的巨大启动胶囊按钮 -->
                    <Button Classes="PclLaunch" Command="{Binding LaunchGameCommand}"
                            IsEnabled="{Binding !IsLaunching}"
                            HorizontalAlignment="Stretch" Height="52">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <!-- 播放三角图标 -->
                            <Path Data="M 0,0 L 0,16 L 14,8 Z" Fill="White" VerticalAlignment="Center" />
                            <TextBlock Text="启动游戏" FontWeight="Black" FontSize="18" Foreground="White"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧内容面板 (Right Panel) - 版本卡片与信息流 -->
        <ScrollViewer Grid.Column="1" Margin="24,20">
            <StackPanel Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
                <!-- 提示卡片 -->
                <Border Background="{DynamicResource NeoColorGray8Brush}" CornerRadius="10" Padding="18,14"
                        BorderBrush="{DynamicResource NeoColorGray6Brush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="📢" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="欢迎使用 PCL.Neo 跨平台重构版" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="原生 Avalonia 自绘驱动，纯正 .NET 10 强力运行，已适配 Linux / macOS / Windows。"
                                       Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 当前选中的版本大卡片 -->
                <Border Background="{DynamicResource NeoColorGray8Brush}" CornerRadius="10" Padding="20"
                        BorderBrush="{DynamicResource NeoSystemAccentColorStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="当前选中的游戏版本" FontWeight="SemiBold" FontSize="14" Opacity="0.8" />
                            <Button Grid.Column="1" Content="刷新版本" Command="{Binding RefreshDataCommand}" Padding="8,3" FontSize="12" />
                        </Grid>

                        <ComboBox ItemsSource="{Binding Instances}"
                                  SelectedItem="{Binding SelectedInstance}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="inst:LocalInstance">
                                    <StackPanel Spacing="2" Margin="2,4">
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding DirectoryPath}" Opacity="0.6" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 社区与开源指引卡片 -->
                <Border Background="{DynamicResource NeoColorGray8Brush}" CornerRadius="10" Padding="18"
                        BorderBrush="{DynamicResource NeoColorGray6Brush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="关于重构" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="本项目依照《PCL 存储库合理使用指南》对 PCL 进行非商业性独立二次开发，核心库与 UI 完全解耦，实现 Linux 和其他架构平台的原生支持。"
                                   Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.PclLaunch">
            <Setter Property="Background" Value="{DynamicResource NeoSystemAccentColorBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Duration="0:0:0.15" Property="Background" />
                    <TransformOperationsTransition Duration="0:0:0.15" Property="RenderTransform" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PclLaunch:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NeoSystemAccentColorLight2Brush}" />
        </Style>
        <Style Selector="Button.PclLaunch:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
    </UserControl.Styles>

</UserControl>
