<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCL.Neo.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PCL.Neo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Plain Craft Launcher 2"
        Width="880" Height="530" MinWidth="810" MinHeight="470">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="46,*">
        <!-- 1. 顶部全宽 Banner：1:1 还原 PCL 经典标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource NeoSystemAccentColorBrush}"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- 左侧：PCL 官方原版矢量标志 (M26,29 v-25 h6 a7,7...) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Path Data="M26,29 v-25 h6 a7,7 180 0 1 0,14 h-6 M62.5,6.5 a10,11.5 180 1 0 0,18 M71,2.5 v24.5 h13.5"
                          Stroke="White" StrokeThickness="2.3" Fill="Transparent"
                          Stretch="Uniform" Width="36" Height="22" VerticalAlignment="Center" />

                    <TextBlock Text="Plain Craft Launcher" Foreground="White"
                               FontWeight="Bold" FontSize="14.5" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 居中：PCL 经典半透明胶囊单选导航条 (PanTitleSelect) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <RadioButton Classes="PclTitleSelect" Content="启动"
                                 IsChecked="{Binding IsLaunchTabSelected}" />
                    <RadioButton Classes="PclTitleSelect" Content="下载"
                                 IsChecked="{Binding IsDownloadTabSelected}" />
                    <RadioButton Classes="PclTitleSelect" Content="设置"
                                 IsChecked="{Binding IsSettingsTabSelected}" />
                    <RadioButton Classes="PclTitleSelect" Content="关于"
                                 IsChecked="{Binding IsAboutTabSelected}" />
                </StackPanel>

                <!-- 右侧：平台标签与状态 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Border Background="#25FFFFFF" CornerRadius="12" Padding="8,3">
                        <TextBlock Text="{Binding CurrentPlatformShort}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 主体内容区：PCL 经典微灰背景 -->
        <Border Grid.Row="1" Background="{DynamicResource NeoColorGray7Brush}">
            <ContentControl Content="{Binding CurrentPageView}" />
        </Border>
    </Grid>

    <Window.Styles>
        <!-- PCL 顶栏 PanTitleSelect 胶囊样式 1:1 还原 -->
        <Style Selector="RadioButton.PclTitleSelect">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DFFFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PanBack"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.PclTitleSelect:pointerover /template/ Border#PanBack">
            <Setter Property="Background" Value="#25FFFFFF" />
        </Style>

        <Style Selector="RadioButton.PclTitleSelect:checked">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="RadioButton.PclTitleSelect:checked /template/ Border#PanBack">
            <Setter Property="Background" Value="#45FFFFFF" />
        </Style>
    </Window.Styles>

</Window>
